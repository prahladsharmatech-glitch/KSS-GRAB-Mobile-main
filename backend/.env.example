# Copy this file to .env and fill in real values. NEVER commit .env.

# Supabase
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable__<your-anon-key>

# Service role key — get from Supabase Dashboard → Project Settings → API → service_role
# Required for backend writes to RLS-protected tables (orders, profiles, etc.)
# NEVER expose this to clients or commit it to source control.
SUPABASE_SERVICE_KEY=<your-service-role-key>

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=<generate-a-strong-random-secret>

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://<your-redis>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-redis-token>

# Cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://grabit-main.vercel.app,http://localhost:5173,http://localhost:3000

# Set to false in production
OTP_DEBUG=true
